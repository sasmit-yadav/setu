# ══ SETU .env.example ══
#
# Every key in Part 25's table appears here, with a PLACEHOLDER and never a real
# value. scripts/check_env_example.py fails the build if this file and Part 25
# drift apart.
#
# Copy to .env and fill in.  .env is gitignored and must stay that way.

# ── Database: TWO urls, not one (Part 23) ──
# POOLED  = app runtime. Neon hostname contains "-pooler".
# DIRECT  = migrations ONLY. Transaction-mode pooling breaks session-level DDL,
#           which is the entire reason these are separate.
#
# ⚠ asyncpg REJECTS "?sslmode=require" in the URL — strip it from the pooled URL
#   and pass ssl via connect_args. Leave the DIRECT url exactly as Neon gives it.
DATABASE_URL_POOLED=postgresql+asyncpg://setu:setu@localhost:5433/setu
DATABASE_URL_DIRECT=postgresql://setu:setu@localhost:5433/setu

# ── Pool sizing: ENV, not app_config. The documented bootstrap exception
#    (Part 38): you cannot read a config table before you have a pool to
#    read it with. Do NOT "fix" these into app_config. ──
DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_S=10

# ── Redis: LOCAL for dev, ALWAYS (§1.4). The Upstash url belongs in Render's
#    environment, never in your local .env. ──
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=setu:v1

# ── Channels ──
FCM_SERVICE_ACCOUNT_JSON=./secrets/fcm-service-account.json
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+15005550006
BREVO_API_KEY=xkeysib-xxxxxxxx

# ── v3.0 secrets — READ Part 25's rotation notes before touching either ──
# PHONE_HASH_PEPPER is a DATA-SHAPING secret. Rotating it invalidates every
#   phone_hash and silently breaks dedupe: it is a MIGRATION, not an env swap.
#   Migration 0012 FAILS LOUDLY if this is absent, by design (Trap 11).
PHONE_HASH_PEPPER=generate-with-scripts/gen_secrets.py
# ALERT_SIGNING_SEED_B64 is CLIENT-COUPLED. The public key is baked into the PWA
#   bundle, so rotating it is a RELEASE, not an env change (Rule 11).
ALERT_SIGNING_SEED_B64=generate-with-scripts/gen_secrets.py

# ── ML service (Part 22 — services/api must NEVER import torch) ──
HF_SPACE_URL=https://your-space.hf.space
INTERNAL_ML_KEY=generate-a-long-random-string

# ── Platform ──
JWT_SIGNING_SECRET=generate-a-long-random-string
WEBHOOK_HMAC_SECRET=generate-a-long-random-string
SENTRY_DSN=
SENTRY_ENABLED=true
OPENCELLID_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
SLACK_OR_DISCORD_ALERT_WEBHOOK=
