# ── secrets: nothing here may ever reach git (Part 12, Part 25) ──
# Broad on purpose: .env, .env.local, .env.neon, .env.anything are ALL
# ignored by this one pattern, so a new per-environment file never needs a
# matching new gitignore line remembered later. .env.example is the one
# deliberate exception, since it's the template teammates copy FROM.
# ── secrets: never commit any .env files ──
.env*
secrets/
*.pem
*-service-account.json

# ── python ──
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── node ──
node_modules/
dist/
.vite/

# ── data: downloaded at build time, never committed (§1.6.2) ──
data/raw/
!data/raw/.gitkeep
data/enrollment/*.csv

# ── committed on purpose: data/seeds/ and data/snapshots/ (Rule 3, §15) ──

# ── os / editor ──
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# TypeScript incremental build cache — machine-local, never committed
*.tsbuildinfo

.cache/

# ── local dev artifacts ──
# vite-plugin-pwa's dev service-worker output; regenerated on every dev run.
dev-dist/
# ngrok tunnel log. Not a credential, but it records the ephemeral public URL
# and is pure local noise.
ngrok.log

# ── citizen sideload APK (Docker output, never commit binaries) ──
*.apk
*.aab
mobile/citizen-apk/.gradle/
mobile/citizen-apk/app/build/
mobile/citizen-apk/build/
mobile/citizen-apk/dist/
mobile/citizen-apk/local.properties
